{#- Macros shared by the community page templates in this directory. -#}

{%- set talk_types = {
    "talk": "Talk",
    "case-study": "Case Study",
    "tutorial": "Tutorial",
    "blog": "Blog Post",
} -%}

{#- Format a YYYY-MM date for display, e.g. "Mar 2026". -#}
{%- macro month(value) -%}
{%- set names = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                 "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"] -%}
{%- set value = value | string -%}
{{ names[value[5:7] | int - 1] }} {{ value[:4] }}
{%- endmacro -%}

{#- Feather icons (https://feathericons.com) for each talk type. -#}
{%- macro type_icon(type) -%}
<svg class="community-icon community-icon-{{ type }}" viewBox="0 0 24 24" aria-hidden="true">
{%- if type == "talk" -%}
<polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
{%- elif type == "case-study" -%}
<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
{%- elif type == "tutorial" -%}
<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>
{%- else -%}
<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
{%- endif -%}
</svg>
{%- endmacro -%}

{#- GitHub mark from Octicons, matching the icon in the top navigation bar. -#}
{%- macro github_icon() -%}
<svg class="adopter-github-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>
{%- endmacro -%}

{#- A talk as a list item with its type icon and date. -#}
{%- macro talk_link(talk) -%}
<li>{{ type_icon(talk.type) }}<a href="{{ talk.url | e }}">{{ talk.title | e }}</a> <span class="talk-date">({{ month(talk.date) }})</span></li>
{%- endmacro -%}

{#- A blog post card. Set searchable to include it in a directory search. -#}
{%- macro blog_card(post, searchable=false) -%}
{%- set search = [post.title, post.event] | select | join(" ") | lower -%}
<a class="blog-post-card" href="{{ post.url | e }}"{% if searchable %} data-search="{{ search | e }}"{% endif %}>
<span class="blog-post-source">{{ type_icon("blog") }}{{ (post.event or talk_types["blog"]) | e }}</span>
<span class="blog-post-title">{{ post.title | e }}</span>
<span class="blog-post-footer">{{ month(post.date) }}</span>
</a>
{%- endmacro -%}

{#- A search box, a match counter, and a grid of the searchable cards from caller(). -#}
{%- macro directory(total, noun, placeholder) -%}
<div class="directory">
<div class="directory-search">
<input type="search" class="directory-search-input" placeholder="{{ placeholder }}" aria-label="{{ placeholder }}">
<p class="directory-count" aria-live="polite">Showing <span class="directory-visible-count">{{ total }}</span> of {{ total }} {{ noun }}</p>
</div>
<div class="directory-grid">
{{ caller() }}
</div>
<p class="directory-empty" hidden>No {{ noun }} match your search.</p>
</div>
{%- endmacro -%}
